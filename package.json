{
  "name": "cyber-doc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=12.15.0 <13"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "next build",
    "check:data": "tsx scripts/data-quality-check.ts",
    "check:contracts": "node scripts/contract-audit.mjs",
    "check:feature-docs": "node scripts/quality/feature-docs-check.mjs",
    "performance:budgets": "tsx scripts/performance/check-budgets.ts",
    "security:gitleaks": "node scripts/quality/gitleaks-check.mjs",
    "quality:floor": "node scripts/quality/floor-guard.mjs",
    "quality:dependencies": "pnpm audit --audit-level=high",
    "quality:fast": "pnpm run quality:floor && pnpm run check:feature-docs && pnpm run release:secret-scan && pnpm run security:gitleaks && pnpm run lint && pnpm run type-check && pnpm run test:unit && pnpm run quality:dependencies",
    "quality:verify": "pnpm run quality:fast && pnpm run check:contracts && pnpm run i18n:audit && pnpm run build && pnpm run performance:budgets",
    "quality:prepush": "pnpm run release:preflight && pnpm run test:e2e:critical",
    "hooks:install": "node scripts/quality/install-git-hooks.mjs",
    "release:preflight": "pnpm run quality:verify && pnpm exec prisma migrate status",
    "release:freeze-audit": "powershell -ExecutionPolicy Bypass -File ./scripts/release/freeze-audit.ps1",
    "release:github-protection": "node scripts/release/github-protection-check.mjs",
    "release:github-protection:plan": "node scripts/release/github-protection-sync.mjs",
    "release:github-protection:apply": "node scripts/release/github-protection-sync.mjs --apply",
    "release:github-secrets": "node scripts/release/github-ci-secret-check.mjs",
    "release:github-secrets:plan": "node scripts/release/github-ci-secret-sync.mjs",
    "release:github-secrets:apply": "node scripts/release/github-ci-secret-sync.mjs --apply",
    "release:github-label": "node scripts/release/github-quality-label-check.mjs --pr 12",
    "release:scope:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/release/prepare-freeze-scope.ps1",
    "release:scope:apply": "powershell -ExecutionPolicy Bypass -File ./scripts/release/prepare-freeze-scope.ps1 -Apply",
    "release:secret-scan": "node scripts/release/secret-scan.mjs",
    "db:seed": "prisma db seed",
    "release:smoke:critical": "pnpm run test:e2e:critical",
    "test:e2e:critical": "node scripts/e2e-critical-runner.mjs",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "dev": "next dev",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "lint": "eslint .",
    "lint:ci": "eslint . --ext .ts,.tsx",
    "smoke:admin": "node scripts/admin-smoke-runner.mjs",
    "smoke:permissions": "node scripts/permissions-smoke-runner.mjs",
    "check:ux": "node scripts/ux-route-check-runner.mjs",
    "smoke:documents": "node scripts/documents-smoke-runner.mjs",
    "type-check": "tsc --noEmit",
    "start": "node scripts/start-standalone.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^3.10.0",
    "@next/env": "16.4.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "2.0.1",
    "autoprefixer": "^10.4.24",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "docxtemplater": "^3.68.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "8.5.1",
    "geist": "1.8.2",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "pg": "^8.20.0",
    "pizzip": "^3.2.0",
    "playwright": "^1.58.2",
    "react": "^19.3.1",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^15.7.4",
    "react-resizable-panels": "^2.1.9",
    "recharts": "2.15.4",
    "sanitize-html": "2.18.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.3",
    "mammoth": "^1.11.0",
    "postcss": "^8.5.6",
    "prettier": "3.0.0",
    "prisma": "^7.10.1",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18",
    "translate": "^3.0.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1"
  }
}
