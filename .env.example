# Copy to a deployment-specific secret/config store. Do not commit real values.
NODE_ENV=production

# Application and authentication
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
NEXT_PUBLIC_APP_URL=

# PostgreSQL. For the bundled Compose database, DATABASE_URL uses host `db`.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Immutable, same-revision release images. Never use `latest`.
CYBERDOC_IMAGE=
CYBERDOC_MIGRATOR_IMAGE=

# Generated document volume inside the container.
DOCS_STORAGE_DIR=/app/storage
